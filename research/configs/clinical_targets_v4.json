{
  "version": "stethofuse-clinical-targets-v4",
  "declared_utc": "2026-11-20",
  "declaration": "v4 keeps every v3 setting and adds owner-supplied open datasets, declared before any v4 result. (1) COPD adds BRACETS (Pessoa et al. 2023, CC BY 4.0), each hospital as its own dataset: Thessaloniki has healthy and COPD adults; Aveiro has no healthy subjects and is dropped by the both-classes rule. (2) Aortic and mitral regurgitation add the Mendeley heart-regurgitation dataset (jfbdvjw6sf, CC BY 4.0, Littmann 3200) to BMD-HS, with the same pooled-site rules as the lung targets (site-only baseline, both classes per dataset, split stratified by site and class). Its patient label comes from echocardiography: present = any graded finding of that valve at grade 1 or more; absent = no finding of that valve; trace-only or ungraded findings and metallic prosthetic valves match neither class. (3) Pneumonia is unchanged: BRACETS 'infection' is not a pneumonia diagnosis and is not relabelled. (4) Not used: HeartWave (no data link published), ZCHSound (recordings not yet obtained), Zhou et al. 2024 and the long-term-care pneumonia study (data only on request).",
  "data_root_env": "STETHOFUSE_CLINICAL_DATA",
  "default_data_root": "../../OwnerRelease/clinical-data-20261120/extracted",
  "cache_dir_env": "STETHOFUSE_CLINICAL_CACHE",
  "default_cache_dir": "../../OwnerRelease/clinical-data-20261120/features",
  "audio": {
    "sample_rate_hz": 4000,
    "window_sec": 5.0,
    "hop_sec": 2.5,
    "min_sec": 2.0,
    "max_windows_per_recording": 24,
    "n_fft": 512,
    "hop_samples": 80,
    "n_mels": 48,
    "fmin_hz": 20.0,
    "fmax_hz": 1900.0
  },
  "split": {
    "seed": 20261120,
    "test_fraction": 0.25,
    "cv_folds": 5
  },
  "bootstrap": {
    "resamples": 2000,
    "confidence": 0.95
  },
  "models": {
    "prior": {
      "features": "handcrafted",
      "classifier": "prior"
    },
    "features_logreg": {
      "features": "handcrafted",
      "classifier": "logreg"
    },
    "features_boosted_trees": {
      "features": "handcrafted",
      "classifier": "boosted_trees"
    },
    "panns_logreg": {
